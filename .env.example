# The app runs entirely against the in-memory mock HCM (MSW), so no env vars
# are required to run it. Copy this file to `.env.local` only if you want to
# override the defaults below.

# Mock HCM (MSW) is ENABLED by default in the browser. Set to `disabled` to
# turn the worker off and talk to a real backend instead.
# NEXT_PUBLIC_API_MOCKING=disabled
